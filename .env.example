PORT=8787
GRAMPS_URL=
GRAMPS_USER=
GRAMPS_PASSWORD=
DATA_DIR=/app/data
TZ=Europe/Vienna

ADMIN_USER=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional: if omitted, a persistent secret is generated in DATA_DIR.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12

FORM_ACCESS_PASSWORD=change-this-family-password
FORM_ACCESS_DAYS=7
# Optional: defaults to ADMIN_SESSION_SECRET.
FORM_COOKIE_SECRET=

MAX_UPLOAD_MB=15
SUBMIT_RATE_LIMIT=5
NEXTCLOUD_ACCESS_TOKEN=

# Cloudflare Turnstile (bot protection on the public submission form).
# Leave empty to disable the check (e.g. local development).
TURNSTILE_SECRET_KEY=
# Comma-separated list of hostnames the widget is expected to run on.
TURNSTILE_ALLOWED_HOSTNAMES=porodica.repkonet.com
