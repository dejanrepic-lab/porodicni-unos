FORM_ACCESS_PASSWORD=change-this-family-password
FORM_ACCESS_DAYS=7
# Optional: defaults to ADMIN_SESSION_SECRET.
FORM_COOKIE_SECRET=

MAX_UPLOAD_MB=15
SUBMIT_RATE_LIMIT=5
NEXTCLOUD_ACCESS_TOKEN=
